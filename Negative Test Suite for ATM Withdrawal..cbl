IDENTIFICATION DIVISION.
PROGRAM-ID. ATM-WITHDRAWAL.

DATA DIVISION.
WORKING-STORAGE SECTION.

01 BALANCE PIC 9(7) VALUE 0.
01 WITHDRAWAL-AMOUNT PIC 9(7) VALUE 0.
01 REMAINING-BALANCE PIC 9(7) VALUE 0.

01 ACCOUNT-STATUS PIC X.
01 ATM-STATUS PIC X.

01 STATUS-CODE PIC X(3).

PROCEDURE DIVISION.

    DISPLAY "ENTER ACCOUNT BALANCE: "
    ACCEPT BALANCE.

    DISPLAY "ENTER WITHDRAWAL AMOUNT: "
    ACCEPT WITHDRAWAL-AMOUNT.

    DISPLAY "ENTER ACCOUNT STATUS (A/I): "
    ACCEPT ACCOUNT-STATUS.

    DISPLAY "ENTER ATM STATUS (Y/N): "
    ACCEPT ATM-STATUS.

    IF ACCOUNT-STATUS NOT = "A"

        MOVE "101" TO STATUS-CODE
        DISPLAY "ACCOUNT IS INACTIVE"
        DISPLAY "STATUS CODE: " STATUS-CODE

    ELSE
        IF ATM-STATUS NOT = "Y"

            MOVE "102" TO STATUS-CODE
            DISPLAY "ATM IS NOT AVAILABLE"
            DISPLAY "STATUS CODE: " STATUS-CODE

        ELSE
            IF WITHDRAWAL-AMOUNT <= 0

                MOVE "103" TO STATUS-CODE
                DISPLAY "INVALID WITHDRAWAL AMOUNT"
                DISPLAY "STATUS CODE: " STATUS-CODE

            ELSE
                IF WITHDRAWAL-AMOUNT > BALANCE

                    MOVE "104" TO STATUS-CODE
                    DISPLAY "INSUFFICIENT BALANCE"
                    DISPLAY "STATUS CODE: " STATUS-CODE

                ELSE

                    MOVE "000" TO STATUS-CODE

                    COMPUTE REMAINING-BALANCE =
                        BALANCE - WITHDRAWAL-AMOUNT

                    DISPLAY "WITHDRAWAL SUCCESSFUL"
                    DISPLAY "STATUS CODE: " STATUS-CODE
                    DISPLAY "REMAINING BALANCE: "
                        REMAINING-BALANCE

                END-IF
            END-IF
        END-IF
    END-IF.

    STOP RUN.
